{
  "name": "nodeveil-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.json",
    "test:e2e": "RUN_E2E=1 node --test test/e2e_smoke.test.mjs test/graph_e2e.test.mjs",
    "bench:perf": "node perf/bench.mjs",
    "bench:graph": "node perf/graph.perf.mjs",
    "bench:theme": "node perf/theme.perf.mjs",
    "package:linux": "echo electron-builder --linux AppImage",
    "package:win": "echo electron-builder --win nsis",
    "package:mac": "echo electron-builder --mac dmg"
  },
  "packageManager": "pnpm@10.18.3"
}
